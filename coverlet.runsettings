<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[DocumentManagementSystem.Persistence]DocumentManagementSystem.Persistence.Migrations.*,[DocumentManagementSystem.Api]Program*,[DocumentManagementSystem.OcrWorker]Program*,[DocumentManagementSystem.TestHelpers]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
