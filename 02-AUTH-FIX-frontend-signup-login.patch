+import { zodResolver } from '@hookform/resolvers/zod';
+import PersonAddRoundedIcon from '@mui/icons-material/PersonAddRounded';
+import { Alert, Box, Button, Card, CardContent, Stack, TextField, Typography } from '@mui/material';
+import { useForm } from 'react-hook-form';
+import { Link, Navigate, useNavigate } from 'react-router-dom';
+import { ApiError } from '../api/http';
+import { useAuth } from '../features/auth/AuthContext';
+import { registerSchema, type RegisterFormValues } from '../features/auth/validation';
+
+export function RegisterPage() {
+  const auth = useAuth();
+  const navigate = useNavigate();
+  const { register, handleSubmit, formState: { errors, isSubmitting }, setError } = useForm<RegisterFormValues>({
+    resolver: zodResolver(registerSchema),
+    defaultValues: { username: '', password: '', confirmPassword: '' },
+  });
+
+  if (auth.isAuthenticated) return <Navigate to="/" replace />;
+
+  const submit = handleSubmit(async (values) => {
+    try {
+      await auth.register({ username: values.username.trim(), password: values.password });
+      navigate('/', { replace: true });
+    } catch (error) {
+      setError('root', {
+        message: error instanceof ApiError && error.status === 409
+          ? 'That username is already taken.'
+          : error instanceof Error ? error.message : 'Sign up failed.',
+      });
+    }
+  });
+
+  return (
+    <Box sx={{ minHeight: '100vh', display: 'grid', placeItems: 'center', p: 2, bgcolor: 'background.default' }}>
+      <Card sx={{ width: '100%', maxWidth: 480 }}>
+        <CardContent sx={{ p: { xs: 3, sm: 5 } }}>
+          <Stack component="form" onSubmit={submit} spacing={2.5}>
+            <Stack alignItems="center" spacing={1}>
+              <PersonAddRoundedIcon color="primary" sx={{ fontSize: 44 }} />
+              <Typography variant="h4">Create account</Typography>
+              <Typography color="text.secondary" textAlign="center">Register once, then use JWT authentication for the protected API.</Typography>
+            </Stack>
+
+            {errors.root && <Alert severity="error">{errors.root.message}</Alert>}
+
+            <TextField
+              label="Username"
+              autoComplete="username"
+              autoFocus
+              error={Boolean(errors.username)}
+              helperText={errors.username?.message ?? '3–50 characters: letters, numbers, _ and -'}
+              {...register('username')}
+            />
+            <TextField
+              label="Password"
+              type="password"
+              autoComplete="new-password"
+              error={Boolean(errors.password)}
+              helperText={errors.password?.message ?? 'At least 8 characters with upper/lowercase, number and symbol.'}
+              {...register('password')}
+            />
+            <TextField
+              label="Confirm password"
+              type="password"
+              autoComplete="new-password"
+              error={Boolean(errors.confirmPassword)}
+              helperText={errors.confirmPassword?.message}
+              {...register('confirmPassword')}
+            />
+
+            <Button type="submit" variant="contained" size="large" disabled={isSubmitting}>
+              {isSubmitting ? 'Creating account…' : 'Sign up'}
+            </Button>
+            <Button component={Link} to="/login" color="inherit">
+              Already have an account? Sign in
+            </Button>
+          </Stack>
+        </CardContent>
+      </Card>
+    </Box>
+  );
+}
