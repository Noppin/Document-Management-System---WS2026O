@@ -0,0 +1,77 @@
+import { zodResolver } from '@hookform/resolvers/zod';
+import LockRoundedIcon from '@mui/icons-material/LockRounded';
+import { Alert, Box, Button, Card, CardContent, Stack, TextField, Typography } from '@mui/material';
+import { useForm } from 'react-hook-form';
+import { Link, Navigate, useLocation, useNavigate } from 'react-router-dom';
+import { ApiError } from '../api/http';
+import { useAuth } from '../features/auth/AuthContext';
+import { loginSchema, type LoginFormValues } from '../features/auth/validation';
+
+export function LoginPage() {
+  const auth = useAuth();
+  const navigate = useNavigate();
+  const location = useLocation();
+  const from = (location.state as { from?: string } | null)?.from ?? '/';
+
+  const { register, handleSubmit, formState: { errors, isSubmitting }, setError } = useForm<LoginFormValues>({
+    resolver: zodResolver(loginSchema),
+    defaultValues: { username: '', password: '' },
+  });
+
+  if (auth.isAuthenticated) return <Navigate to="/" replace />;
+
+  const submit = handleSubmit(async (values) => {
+    try {
+      await auth.login({ username: values.username.trim(), password: values.password });
+      navigate(from, { replace: true });
+    } catch (error) {
+      setError('root', {
+        message: error instanceof ApiError && error.status === 401
+          ? 'Username or password is incorrect.'
+          : error instanceof Error ? error.message : 'Sign in failed.',
+      });
+    }
+  });
+
+  return (
+    <Box sx={{ minHeight: '100vh', display: 'grid', placeItems: 'center', p: 2, bgcolor: 'background.default' }}>
+      <Card sx={{ width: '100%', maxWidth: 460 }}>
+        <CardContent sx={{ p: { xs: 3, sm: 5 } }}>
+          <Stack component="form" onSubmit={submit} spacing={2.5}>
+            <Stack alignItems="center" spacing={1}>
+              <LockRoundedIcon color="primary" sx={{ fontSize: 44 }} />
+              <Typography variant="h4">Sign in</Typography>
+              <Typography color="text.secondary" textAlign="center">Access your document workspace.</Typography>
+            </Stack>
+
+            {errors.root && <Alert severity="error">{errors.root.message}</Alert>}
+
+            <TextField
+              label="Username"
+              autoComplete="username"
+              autoFocus
+              error={Boolean(errors.username)}
+              helperText={errors.username?.message}
+              {...register('username')}
+            />
+            <TextField
+              label="Password"
+              type="password"
+              autoComplete="current-password"
+              error={Boolean(errors.password)}
+              helperText={errors.password?.message}
+              {...register('password')}
+            />
+
+            <Button type="submit" variant="contained" size="large" disabled={isSubmitting}>
+              {isSubmitting ? 'Signing in…' : 'Sign in'}
+            </Button>
+            <Button component={Link} to="/register" color="inherit">
+              No account yet? Sign up
+            </Button>
+          </Stack>
+        </CardContent>
+      </Card>
+    </Box>
+  );
+}
