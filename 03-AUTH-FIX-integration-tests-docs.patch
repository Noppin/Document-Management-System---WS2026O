+using DocumentManagementSystem.Application.Dtos;
+using DocumentManagementSystem.Application.Services;
+using DocumentManagementSystem.Application.Validation;
+using DocumentManagementSystem.Domain.Entities;
+using Microsoft.AspNetCore.Identity;
+
+namespace DocumentManagementSystem.Persistence.Tests;
+
+public sealed class AuthServiceTests
+{
+    private readonly InMemoryTestDatabase database = new();
+
+    [Fact]
+    public async Task RegisterThenLogin_WithCorrectPassword_Succeeds()
+    {
+        var service = CreateService();
+        var registration = await service.RegisterAsync(new RegisterRequest("mark", "StrongPass1!"));
+
+        Assert.True(registration.Succeeded);
+        var user = await service.AuthenticateAsync(new LoginRequest("mark", "StrongPass1!"));
+        Assert.NotNull(user);
+        Assert.Equal("mark", user!.Username);
+    }
+
+    [Fact]
+    public async Task Register_DuplicateUsernameIgnoringCase_IsRejected()
+    {
+        var service = CreateService();
+        await service.RegisterAsync(new RegisterRequest("Mark", "StrongPass1!"));
+
+        var second = await service.RegisterAsync(new RegisterRequest("mark", "StrongPass1!"));
+        Assert.False(second.Succeeded);
+        Assert.Equal("username_taken", second.ErrorCode);
+    }
+
+    [Fact]
+    public async Task Login_WithWrongPassword_ReturnsNull()
+    {
+        var service = CreateService();
+        await service.RegisterAsync(new RegisterRequest("mark", "StrongPass1!"));
+
+        Assert.Null(await service.AuthenticateAsync(new LoginRequest("mark", "WrongPass1!")));
+    }
+
+    private AuthService CreateService() => new(
+        new UserRepository(database.CreateContext()),
+        new PasswordHasher<User>(),
+        new RegisterRequestValidator(),
+        new LoginRequestValidator());
+}
