+#!/usr/bin/env bash
+set -uo pipefail
+
+cd "$(dirname "$0")/.."
+
+FRONTEND_URL="${FRONTEND_URL:-http://localhost}"
+API_URL="${API_URL:-$FRONTEND_URL/api}"
+PASS=0
+FAIL=0
+
+ok() { printf '  ok    %s\n' "$1"; PASS=$((PASS + 1)); }
+bad() { printf '  FAIL  %s\n' "$1"; FAIL=$((FAIL + 1)); }
+status() { curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$@" 2>/dev/null; }
+expect() { local label="$1" expected="$2"; shift 2; local actual; actual="$(status "$@")"; [ "$actual" = "$expected" ] && ok "$label -> $actual" || bad "$label -> got $actual, want $expected"; }
+
+echo "Compose services"
+running="$(docker compose ps --status running --services 2>/dev/null)"
+for service in postgres api frontend; do
+  printf '%s\n' "$running" | grep -qx "$service" && ok "$service is running" || bad "$service is not running"
+done
+
+echo
+echo "Frontend and public health"
+expect "GET /" 200 "$FRONTEND_URL/"
+expect "GET /api/health" 200 "$API_URL/health"
+
+echo
+echo "JWT authentication"
+expect "documents require JWT" 401 "$API_URL/documents"
+expect "collections require JWT" 401 "$API_URL/collections"
+
+USERNAME="smoke_$(date +%s)"
+PASSWORD='SmokeTest1!'
+REGISTER_BODY="{\"username\":\"$USERNAME\",\"password\":\"$PASSWORD\"}"
+REGISTER_RESPONSE="$(curl -sS --max-time 10 -H 'Content-Type: application/json' -d "$REGISTER_BODY" "$API_URL/auth/register" 2>/dev/null || true)"
+TOKEN="$(printf '%s' "$REGISTER_RESPONSE" | sed -n 's/.*"accessToken":"\([^"]*\)".*/\1/p')"
+
+if [ -n "$TOKEN" ]; then
+  ok "register returns a JWT"
+else
+  bad "register did not return a JWT: $REGISTER_RESPONSE"
+fi
+
+LOGIN_RESPONSE="$(curl -sS --max-time 10 -H 'Content-Type: application/json' -d "$REGISTER_BODY" "$API_URL/auth/login" 2>/dev/null || true)"
+LOGIN_TOKEN="$(printf '%s' "$LOGIN_RESPONSE" | sed -n 's/.*"accessToken":"\([^"]*\)".*/\1/p')"
+if [ -n "$LOGIN_TOKEN" ]; then
+  ok "login returns a JWT"
+else
+  bad "login did not return a JWT: $LOGIN_RESPONSE"
+fi
+
+if [ -n "$LOGIN_TOKEN" ]; then
+  expect "authenticated documents" 200 -H "Authorization: Bearer $LOGIN_TOKEN" "$API_URL/documents"
+  expect "authenticated collections" 200 -H "Authorization: Bearer $LOGIN_TOKEN" "$API_URL/collections"
+fi
+
+expect "duplicate username is rejected" 409 -H 'Content-Type: application/json' -d "$REGISTER_BODY" "$API_URL/auth/register"
+
+echo
+echo "PostgreSQL"
+if docker compose exec -T postgres pg_isready -U postgres -d document_management >/dev/null 2>&1; then ok "PostgreSQL accepts connections"; else bad "PostgreSQL is not accepting connections"; fi
+
+echo
+echo "$PASS passed, $FAIL failed"
+[ "$FAIL" -eq 0 ]
