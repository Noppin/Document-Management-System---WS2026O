+++ b/frontend/src/features/auth/validation.test.ts
@@ -0,0 +1,16 @@
+import { describe, expect, it } from 'vitest';
+import { loginSchema, registerSchema } from './validation';
+
+describe('authentication validation', () => {
+  it('accepts a strong registration', () => {
+    expect(registerSchema.safeParse({ username: 'mark_01', password: 'StrongPass1!', confirmPassword: 'StrongPass1!' }).success).toBe(true);
+  });
+
+  it('rejects mismatched registration passwords', () => {
+    expect(registerSchema.safeParse({ username: 'mark_01', password: 'StrongPass1!', confirmPassword: 'Different1!' }).success).toBe(false);
+  });
+
+  it('rejects empty login fields', () => {
+    expect(loginSchema.safeParse({ username: '', password: '' }).success).toBe(false);
+  });
+});
