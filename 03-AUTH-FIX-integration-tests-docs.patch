+openapi: 3.0.3
+info:
+  title: Document Management System REST API
+  version: 1.0.0
+  description: REST API for document uploads, collections and JWT authentication.
+security:
+  - bearerAuth: []
+servers:
+  - url: http://localhost:8080
+paths:
+  /auth/register:
+    post:
+      security: []
+      tags: [Authentication]
+      summary: Create a user account and return a JWT
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/RegisterRequest' }
+      responses:
+        '201':
+          description: Account created
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/AuthResponse' }
+        '400': { description: Invalid username or password }
+        '409': { description: Username already exists }
+  /auth/login:
+    post:
+      security: []
+      tags: [Authentication]
+      summary: Sign in and return a JWT
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/LoginRequest' }
+      responses:
+        '200':
+          description: Signed in
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/AuthResponse' }
+        '400': { description: Missing credentials }
+        '401': { description: Invalid credentials }
+  /health:
+    get:
+      security: []
+      summary: Health check
+      responses:
+        '200':
+          description: API is running
+          content:
+            application/json:
+              schema:
+                type: object
+                required: [status]
+                properties:
+                  status: { type: string, example: ok }
+  /documents:
+    post:
+      tags: [Documents]
+      summary: Upload a PDF document
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              required: [file]
+              properties:
+                file: { type: string, format: binary }
+      responses:
+        '201':
+          description: Document uploaded
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/DocumentResponse' }
+        '400': { description: Invalid upload }
+    get:
+      tags: [Documents]
+      summary: List all documents
+      responses:
+        '200':
+          description: Documents
+          content:
+            application/json:
+              schema:
+                type: array
+                items: { $ref: '#/components/schemas/DocumentResponse' }
+  /documents/{id}:
+    parameters:
+      - in: path
+        name: id
+        required: true
+        schema: { type: string, format: uuid }
+    get:
+      tags: [Documents]
+      summary: Get one document
+      responses:
+        '200':
+          description: Document
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/DocumentResponse' }
+        '404': { description: Document not found }
+    delete:
+      tags: [Documents]
+      summary: Delete one document
+      responses:
+        '204': { description: Deleted }
+        '404': { description: Document not found }
+  /documents/{id}/content:
+    parameters:
+      - in: path
+        name: id
+        required: true
+        schema: { type: string, format: uuid }
+    get:
+      tags: [Documents]
+      summary: Download the stored PDF content
+      responses:
+        '200':
+          description: PDF file
+          content:
+            application/pdf:
+              schema: { type: string, format: binary }
+        '404': { description: Document not found }
+  /collections:
+    post:
+      tags: [Collections]
+      summary: Create a collection
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/CreateCollectionRequest' }
+      responses:
+        '201':
+          description: Collection created
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/CollectionResponse' }
+        '400': { description: Collection name is required }
+    get:
+      tags: [Collections]
+      summary: List collections
+      responses:
+        '200':
+          description: Collections
+          content:
+            application/json:
+              schema:
+                type: array
+                items: { $ref: '#/components/schemas/CollectionResponse' }
+  /collections/{id}:
+    parameters:
+      - in: path
+        name: id
+        required: true
+        schema: { type: string, format: uuid }
+    get:
+      tags: [Collections]
+      summary: Get a collection and its documents
+      responses:
+        '200':
+          description: Collection details
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/CollectionDetailResponse' }
+        '404': { description: Collection not found }
+  /collections/{id}/documents:
+    parameters:
+      - in: path
+        name: id
+        required: true
+        schema: { type: string, format: uuid }
+    post:
+      tags: [Collections]
+      summary: Add a document to a collection
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/AssignDocumentRequest' }
+      responses:
+        '204': { description: Document assigned }
+        '404': { description: Document or collection not found }
+  /collections/{id}/documents/{documentId}:
+    parameters:
+      - in: path
+        name: id
+        required: true
+        schema: { type: string, format: uuid }
+      - in: path
+        name: documentId
+        required: true
+        schema: { type: string, format: uuid }
+    delete:
+      tags: [Collections]
+      summary: Remove a document from a collection
+      responses:
+        '204': { description: Document removed }
+        '404': { description: Collection or document link not found }
+components:
+  securitySchemes:
+    bearerAuth:
+      type: http
+      scheme: bearer
+      bearerFormat: JWT
+  schemas:
+    RegisterRequest:
+      type: object
+      required: [username, password]
+      properties:
+        username: { type: string, minLength: 3, maxLength: 50 }
+        password: { type: string, format: password, minLength: 8 }
+    LoginRequest:
+      type: object
+      required: [username, password]
+      properties:
+        username: { type: string }
+        password: { type: string, format: password }
+    AuthResponse:
+      type: object
+      required: [accessToken, expiresAt, userId, username, tokenType]
+      properties:
+        accessToken: { type: string }
+        expiresAt: { type: string, format: date-time }
+        userId: { type: string, format: uuid }
+        username: { type: string }
+        tokenType: { type: string, example: Bearer }
+    DocumentResponse:
+      type: object
+      required: [id, fileName, contentType, fileSize, createdAt]
+      properties:
+        id: { type: string, format: uuid }
+        fileName: { type: string }
+        contentType: { type: string, example: application/pdf }
+        fileSize: { type: integer, format: int64 }
+        createdAt: { type: string, format: date-time }
+    CreateCollectionRequest:
+      type: object
+      required: [name]
+      properties:
+        name: { type: string }
+    AssignDocumentRequest:
+      type: object
+      required: [documentId]
+      properties:
+        documentId: { type: string, format: uuid }
+    CollectionResponse:
+      type: object
+      required: [id, name, createdAt, documentCount]
+      properties:
+        id: { type: string, format: uuid }
+        name: { type: string }
+        createdAt: { type: string, format: date-time }
+        documentCount: { type: integer, format: int32 }
+    CollectionDetailResponse:
+      type: object
+      required: [id, name, createdAt, documents]
+      properties:
+        id: { type: string, format: uuid }
+        name: { type: string }
+        createdAt: { type: string, format: date-time }
+        documents:
+          type: array
+          items: { $ref: '#/components/schemas/DocumentResponse' }
