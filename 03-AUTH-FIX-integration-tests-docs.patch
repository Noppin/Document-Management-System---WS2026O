+#!/usr/bin/env bash
+set -euo pipefail
+
+FILE="${1:-http/sample.pdf}"
+BASE_URL="${2:-http://localhost/api}"
+TOKEN="${DMS_TOKEN:-}"
+
+if [[ ! -f "$FILE" ]]; then
+  echo "File not found: $FILE" >&2
+  exit 1
+fi
+
+if [[ -z "$TOKEN" ]]; then
+  if [[ -z "${DMS_USERNAME:-}" || -z "${DMS_PASSWORD:-}" ]]; then
+    echo "Set DMS_TOKEN, or set DMS_USERNAME and DMS_PASSWORD for an existing account." >&2
+    exit 2
+  fi
+
+  LOGIN_RESPONSE="$(curl -sS --fail-with-body \
+    -H 'Content-Type: application/json' \
+    -d "{\"username\":\"${DMS_USERNAME}\",\"password\":\"${DMS_PASSWORD}\"}" \
+    "$BASE_URL/auth/login")"
+  TOKEN="$(printf '%s' "$LOGIN_RESPONSE" | sed -n 's/.*"accessToken":"\([^"]*\)".*/\1/p')"
+fi
+
+if [[ -z "$TOKEN" ]]; then
+  echo "Could not obtain a JWT." >&2
+  exit 3
+fi
+
+curl --fail-with-body \
+  --request POST \
+  --header "Authorization: Bearer $TOKEN" \
+  --form "file=@${FILE};type=application/pdf" \
+  "$BASE_URL/documents"
+echo
